{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": { "title": "Input Image" }
  },
  "2": {
    "class_type": "ImageScaleBy",
    "inputs": {
      "image": ["1", 0],
      "upscale_method": "lanczos",
      "scale_by": 2.0
    },
    "_meta": { "title": "Target Scale Resize" }
  },
  "3": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    },
    "_meta": { "title": "SDXL Base Checkpoint" }
  },
  "4": {
    "class_type": "SUPIR_model_loader_v2",
    "inputs": {
      "model": ["3", 0],
      "clip": ["3", 1],
      "vae": ["3", 2],
      "supir_model": "SUPIR-v0Q_fp16.safetensors",
      "fp8_unet": false,
      "diffusion_dtype": "bf16",
      "high_vram": false
    },
    "_meta": { "title": "SUPIR Model Loader v2" }
  },
  "5": {
    "class_type": "SUPIR_first_stage",
    "inputs": {
      "SUPIR_VAE": ["4", 1],
      "image": ["2", 0],
      "use_tiled_vae": true,
      "encoder_tile_size": 512,
      "decoder_tile_size": 512,
      "encoder_dtype": "auto"
    },
    "_meta": { "title": "SUPIR First Stage" }
  },
  "6": {
    "class_type": "SUPIR_conditioner",
    "inputs": {
      "SUPIR_model": ["4", 0],
      "latents": ["5", 2],
      "positive_prompt": "high quality, detailed, sharp texture, faithful restoration",
      "negative_prompt": "bad quality, blurry, messy, distorted, watermark"
    },
    "_meta": { "title": "SUPIR Conditioner" }
  },
  "7": {
    "class_type": "SUPIR_sample",
    "inputs": {
      "SUPIR_model": ["4", 0],
      "latents": ["5", 2],
      "positive": ["6", 0],
      "negative": ["6", 1],
      "seed": 42,
      "steps": 30,
      "cfg_scale_start": 4.0,
      "cfg_scale_end": 4.0,
      "EDM_s_churn": 5,
      "s_noise": 1.003,
      "DPMPP_eta": 1.0,
      "control_scale_start": 1.0,
      "control_scale_end": 1.0,
      "restore_cfg": -1.0,
      "keep_model_loaded": false,
      "sampler": "TiledRestoreEDMSampler",
      "sampler_tile_size": 768,
      "sampler_tile_stride": 384
    },
    "_meta": { "title": "SUPIR Sample" }
  },
  "8": {
    "class_type": "SUPIR_decode",
    "inputs": {
      "SUPIR_VAE": ["5", 0],
      "latents": ["7", 0],
      "use_tiled_vae": true,
      "decoder_tile_size": 512,
      "decoder_dtype": "auto"
    },
    "_meta": { "title": "SUPIR Decode" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "iuk_supir",
      "images": ["8", 0]
    },
    "_meta": { "title": "Save SUPIR Image" }
  }
}
