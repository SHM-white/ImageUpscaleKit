{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": { "title": "Input Image" }
  },
  "2": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "v1-5-pruned-emaonly.safetensors"
    },
    "_meta": { "title": "Base Diffusion Checkpoint" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "high resolution, faithful details, clean edges, preserve original identity and clothing",
      "clip": ["2", 1]
    },
    "_meta": { "title": "Positive Prompt" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, artifacts, distorted face, altered clothing, watermark, extra limbs",
      "clip": ["2", 1]
    },
    "_meta": { "title": "Negative Prompt" }
  },
  "5": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "4x-UltraSharp.pth"
    },
    "_meta": { "title": "Pre-Upscale Model" }
  },
  "6": {
    "class_type": "UltimateSDUpscale",
    "inputs": {
      "image": ["1", 0],
      "model": ["2", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "vae": ["2", 2],
      "upscale_by": 2.0,
      "seed": 42,
      "steps": 20,
      "cfg": 5.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.2,
      "upscale_model": ["5", 0],
      "mode_type": "Chess",
      "tile_width": 512,
      "tile_height": 512,
      "mask_blur": 12,
      "tile_padding": 48,
      "seam_fix_mode": "Half Tile",
      "seam_fix_denoise": 0.15,
      "seam_fix_width": 64,
      "seam_fix_mask_blur": 8,
      "seam_fix_padding": 16,
      "force_uniform_tiles": true,
      "tiled_decode": true,
      "batch_size": 1
    },
    "_meta": { "title": "Ultimate SD Upscale" }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "iuk_usdu",
      "images": ["6", 0]
    },
    "_meta": { "title": "Save Upscaled Image" }
  }
}
